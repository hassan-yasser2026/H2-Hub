<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="h2_learning_profile.db" />
        <exclude domain="database" path="h2_learning_profile.db-wal" />
        <exclude domain="database" path="h2_learning_profile.db-shm" />
        <exclude domain="sharedpref" path="h2hub_data.xml" />
        <exclude domain="sharedpref" path="subscription_prefs.xml" />
        <exclude domain="file" path="chat-vision/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="h2_learning_profile.db" />
        <exclude domain="database" path="h2_learning_profile.db-wal" />
        <exclude domain="database" path="h2_learning_profile.db-shm" />
        <exclude domain="sharedpref" path="h2hub_data.xml" />
        <exclude domain="sharedpref" path="subscription_prefs.xml" />
        <exclude domain="file" path="chat-vision/" />
    </device-transfer>
</data-extraction-rules>
