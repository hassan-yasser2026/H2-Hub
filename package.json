{
  "name": "h2-smart-hub-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "ingest": "tsx scripts/ingest.ts",
    "docs:demo": "tsx scripts/create-demo-docs.ts",
    "test:rag": "tsx --test src/server/rag.test.ts src/server/socratic-progress.test.ts",
    "test:safety": "tsx --test src/server/content-safety.test.ts",
    "test:feedback": "tsx --test src/server/feedback-store.test.ts",
    "test:push": "tsx --test src/server/push-notifications.test.ts",
    "test:admin": "tsx --test src/server/admin-auth.test.ts",
    "test:subscriptions": "tsx --test src/server/subscriptions.test.ts src/server/subscription-usage.test.ts",
    "test:vision": "tsx --test src/server/vision-model.test.ts",
    "test:productivity": "tsx --test src/server/documents.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@google/genai": "^2.4.0",
    "@napi-rs/canvas": "^1.0.10",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "replicate": "^1.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "pdfkit": "^0.20.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
