{
  "name": "h2-smart-hub-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "ingest": "tsx scripts/ingest.ts",
    "docs:demo": "tsx scripts/create-demo-docs.ts",
    "test:rag": "tsx --test src/server/rag.test.ts src/server/student-memory.test.ts src/server/socratic-progress.test.ts",
    "test:feedback": "tsx --test src/server/feedback-store.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@qdrant/js-client-rest": "1.18.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.25.0",
    "pdfkit": "^0.20.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
