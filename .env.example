# Public Railway proxy URL. Gemini credentials stay only in Railway variables.
SERVER_URL=https://h2-smart-hub-production.up.railway.app
GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_API_KEY
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=OPTIONAL_SERVER_SIDE_FREE_VISION_FALLBACK_KEY
OPENROUTER_VISION_MODEL=qwen/qwen3.8-27b:free
QDRANT_URL=https://YOUR_QDRANT_CLUSTER_URL
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=h2_hub_knowledge
ELEVEN_LABS_API_KEY=MY_ELEVEN_LABS_API_KEY
ADMIN_FEEDBACK_PASSWORD=SET_A_LONG_RANDOM_ADMIN_PASSWORD
# Optional: use a mounted persistent volume path on Railway; the default local JSON file is ephemeral there.
# FEEDBACK_STORE_PATH=/data/smart-cat-feedback.json
